{
  "name": "unistore",
  "version": "1.0.0",
  "description": "Backend-first InterSwitch Web Checkout integration for the InterSwitch Developer Community workshop",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "mock:gateway": "node scripts/mock-interswitch.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "vitest": "^3.2.7"
  }
}
